<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>capacidadReal</vendor>
  <vendor_url>https://github.com/babinium/capacidadReal</vendor_url>
  <action id="io.github.babinium.capacidadReal.check">
    <description>Comprobar la capacidad de una memoria USB o SD</description>
    <message>Se necesitan permisos para comprobar pequeñas muestras de la memoria seleccionada y restaurar sus datos originales.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/capacidadreal/capacidadreal/helper.py</annotate>
  </action>
</policyconfig>
